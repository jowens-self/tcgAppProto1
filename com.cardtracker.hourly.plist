<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cardtracker.hourly</string>

  <!-- Hourly checks: export, freshness, archive sync, and a pull ONLY when the
       day that should be held is missing (a failed 16:30 slot, a late tcgcsv
       refresh, a Mac that was off at 16:30). The regular pull is the 16:30 slot
       in com.cardtracker.daily, which runs this same script. Both need
       cardtracker-db up; since 2026-09-30 Docker opens at login
       (com.cardtracker.docker-at-login) and the container restarts on its own,
       reversing the 2026-08-13 on-demand decision (DEVELOPMENT_HISTORY.md
       Part 42). -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/skullllbunnies/Claude/tcgAppProto1/scripts/hourly.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/skullllbunnies/Claude/tcgAppProto1</string>

  <!-- launchd hands a job a bare PATH; docker lives in /usr/local/bin. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>DATA_REPO</key><string>/Users/skullllbunnies/Claude/cardtracker-data</string>
  </dict>

  <key>StartInterval</key><integer>3600</integer>

  <key>StandardOutPath</key><string>/Users/skullllbunnies/Library/Logs/cardtracker/hourly.log</string>
  <key>StandardErrorPath</key><string>/Users/skullllbunnies/Library/Logs/cardtracker/hourly.err</string>
</dict>
</plist>
